---
import SimplePage from "../components/SimplePage.astro";
import BookButton from "../components/BookButton.astro";
---

<SimplePage route="/thank-you">
  <div class="flex flex-col items-start gap-5">
    <p class="font-body-lg text-body-lg text-on-surface-variant">Thanks — your request is in. We'll be in touch to set up your free strategy call.</p>
    <p class="font-body-md text-body-md text-on-surface-variant">Want to skip the back-and-forth? Pick a time now.</p>
    <BookButton class="btn-gold px-6 py-3 font-label-lg text-label-lg" />
    <a class="font-label-lg text-label-lg text-cobalt underline underline-offset-4" href="/">Back to the home page</a>
  </div>
</SimplePage>
