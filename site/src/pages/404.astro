---
import "@fontsource-variable/sora";
import "@fontsource-variable/inter";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { business } from "../data/facts.js";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found | {business.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="bg-surface font-body-md text-body-md text-on-surface antialiased">
    <Header />
    <main id="main" class="flex min-h-[70vh] flex-col items-center justify-center gap-5 px-6 pt-20 text-center">
      <p class="eyebrow border-amber-300/80 bg-amber-100 text-amber-800">404</p>
      <h1 class="font-headline-lg text-headline-lg text-on-surface">We couldn't find that page</h1>
      <p class="max-w-md text-on-surface-variant">The link may be old or mistyped. The home page has everything we offer.</p>
      <a class="btn-gold px-6 py-3 font-label-lg text-label-lg" href="/">Go to the home page</a>
    </main>
    <Footer />
  </body>
</html>
