---
import { Icon } from "astro-icon/components";
import { industries, business } from "../data/facts.js";
import { industryCopy } from "../data/home.js";
const tones = [
  { card: "hover:border-blue-400", icon: "bg-blue-100/70 text-cobalt group-hover:bg-cobalt group-hover:text-white" },
  { card: "hover:border-amber-400", icon: "bg-amber-100/70 text-amber-700 group-hover:bg-amber-500 group-hover:text-slate-950" },
];
---

<section class="bg-white px-6 py-16 lg:px-12" id="industries">
  <div class="mx-auto flex max-w-7xl flex-col gap-10">
    <div class="mx-auto flex max-w-3xl flex-col gap-3 text-center">
      <span class="eyebrow mx-auto border-blue-200/80 bg-blue-50 text-cobalt">Field-Tested in Texas</span>
      <h2 class="font-headline-lg text-[28px] font-bold leading-9 text-on-surface sm:text-headline-lg">Engineered specifically for the trades that keep {business.city} running</h2>
      <p class="font-body-md text-body-md text-on-surface-variant">We do not work with e-commerce, influencers, or generic brands. Our systems are built for local home service businesses.</p>
    </div>
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-3 lg:grid-cols-5">
      {industries.map((item, i) => {
        const tone = tones[i % 2];
        const copy = industryCopy[item.slug];
        return (
          <li class={`group flex flex-col gap-3 rounded-xl border border-surface-container bg-surface-container-low p-5 transition-all hover:shadow-md ${tone.card}`}>
            <div class={`flex h-12 w-12 items-center justify-center rounded-xl transition-colors ${tone.icon}`}>
              <Icon name={copy.icon} class="h-7 w-7" aria-hidden="true" />
            </div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface">{item.name}</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">{copy.text}</p>
          </li>
        );
      })}
    </ul>
  </div>
</section>
