---
import { Icon } from "astro-icon/components";
import { faqs } from "../data/home.js";
---

<section class="section bg-surface" id="faq">
  <div class="mx-auto flex max-w-3xl flex-col gap-10">
    <div class="flex flex-col gap-3 text-center">
      <span class="eyebrow mx-auto border-blue-200/80 bg-blue-50 text-cobalt">FAQ</span>
      <h2 class="font-headline-lg text-[28px] font-bold leading-9 text-on-surface sm:text-headline-lg">Common Questions</h2>
    </div>
    <div class="flex flex-col gap-3">
      {faqs.map((f) => (
        <details class="group rounded-xl border border-slate-200 bg-white shadow-sm open:border-amber-400/50">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-headline-sm text-[17px] font-semibold leading-6 text-on-surface [&::-webkit-details-marker]:hidden">
            {f.q}
            <Icon name="material-symbols:add" class="h-6 w-6 shrink-0 text-cobalt transition-transform group-open:rotate-45" aria-hidden="true" />
          </summary>
          <p class="px-5 pb-5 font-body-md text-body-md text-on-surface-variant">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
