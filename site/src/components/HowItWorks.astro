---
import { Icon } from "astro-icon/components";
import { steps } from "../data/home.js";
const looks = [
  { card: "border border-slate-200", num: "border border-blue-200/80 bg-blue-50 text-cobalt", chip: "border-blue-100 bg-blue-50/70 text-cobalt" },
  { card: "border-2 border-amber-400/40", num: "bg-gradient-to-r from-amber-500 to-amber-400 text-slate-950 shadow-md", chip: "border-amber-200 bg-amber-50/70 text-amber-900" },
  { card: "border border-slate-200", num: "bg-primary text-white shadow-md", chip: "border-blue-100 bg-blue-50/70 text-cobalt" },
];
---

<section class="section bg-surface" id="how-it-works">
  <div class="mx-auto flex max-w-7xl flex-col gap-14">
    <div class="mx-auto flex max-w-2xl flex-col gap-3 text-center">
      <span class="eyebrow mx-auto border-amber-300/80 bg-amber-100 text-amber-800">Transparent Process</span>
      <h2 class="font-headline-lg text-[28px] font-bold leading-9 text-on-surface sm:text-headline-lg">Simple, Transparent, and Hassle-Free</h2>
      <p class="font-body-md text-body-md text-on-surface-variant">You focus on running your service crews. We handle your pipeline.</p>
    </div>
    <ol class="relative grid grid-cols-1 gap-8 md:grid-cols-3">
      {steps.map((step, i) => (
        <li class={`relative flex flex-col gap-4 rounded-2xl bg-white p-8 shadow-sm transition-shadow hover:shadow-md ${looks[i].card}`}>
          <div class={`flex h-14 w-14 items-center justify-center rounded-2xl font-headline-md text-headline-md font-extrabold ${looks[i].num}`} aria-hidden="true">{String(i + 1).padStart(2, "0")}</div>
          <h3 class="font-headline-md text-headline-md font-bold text-on-surface">{i + 1}. {step.title}</h3>
          <p class="font-body-sm text-body-sm leading-relaxed text-on-surface-variant">{step.text}</p>
          <div class={`mt-auto flex items-center gap-2 rounded-xl border p-3 font-label-sm text-label-sm font-semibold ${looks[i].chip}`}>
            <Icon name={step.icon} class="h-[18px] w-[18px] shrink-0 text-amber-600" aria-hidden="true" /> {step.chip}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
