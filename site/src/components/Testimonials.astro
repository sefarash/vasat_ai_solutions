---
import { Icon } from "astro-icon/components";
import { testimonials, reservedSpots } from "../data/home.js";
---

<section class="section bg-white" id="testimonials">
  <div class="mx-auto flex max-w-7xl flex-col gap-12">
    <div class="mx-auto flex max-w-2xl flex-col gap-3 text-center">
      <span class="eyebrow mx-auto border-blue-200 bg-blue-50 text-cobalt">Real Results</span>
      <h2 class="font-headline-lg text-[28px] font-bold leading-9 text-on-surface sm:text-headline-lg">Real Results from Real Contractors</h2>
      <p class="font-body-md text-body-md text-on-surface-variant">See what happens when trade contractors stop missing calls.</p>
    </div>
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {testimonials.map((t) => (
        <figure class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-surface-container-low p-8 shadow-sm transition-shadow hover:shadow-md">
          <div class="flex flex-col gap-4">
            <div class="flex items-center text-amber-500" role="img" aria-label="5 out of 5 stars">
              {[1, 2, 3, 4, 5].map(() => <Icon name="material-symbols:star" class="h-6 w-6" aria-hidden="true" />)}
            </div>
            <blockquote class="font-body-md text-body-md italic leading-relaxed text-on-surface">"{t.quote}"</blockquote>
          </div>
          <figcaption class="-mx-8 -mb-8 mt-6 rounded-b-2xl border-t border-slate-200 bg-white p-6">
            <p class="font-headline-sm text-headline-sm font-bold text-on-surface">{t.name}</p>
            <p class="font-label-sm text-label-sm text-on-surface-variant">{t.role}</p>
          </figcaption>
        </figure>
      ))}
      {Array.from({ length: reservedSpots }).map(() => (
        <div class="flex flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-slate-300 bg-surface-container-low p-8 text-center">
          <span class="rounded-full border border-amber-300 bg-amber-100 px-3 py-1 font-label-sm text-label-sm font-bold text-amber-800">Spot reserved for a founding client</span>
          <p class="font-body-md text-body-md text-on-surface-variant">Your review here — results coming soon.</p>
          <a class="font-label-lg text-label-lg text-cobalt underline underline-offset-4 hover:text-primary" href="#contact">Become a founding client</a>
        </div>
      ))}
    </div>
  </div>
</section>
