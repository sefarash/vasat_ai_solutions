---
import { Icon } from "astro-icon/components";
import BookButton from "./BookButton.astro";
import { plans, services, usd } from "../data/facts.js";
import { planFeatures, popularPlan } from "../data/home.js";
---

<section class="section bg-gradient-to-b from-navy-850 to-navy-950 text-white" id="pricing">
  <div class="mx-auto flex max-w-7xl flex-col gap-12">
    <div class="mx-auto flex max-w-2xl flex-col gap-3 text-center">
      <span class="eyebrow mx-auto border-amber-400/40 bg-amber-400/20 text-amber-300">Pricing</span>
      <h2 class="font-headline-lg text-[28px] font-bold leading-9 text-white sm:text-headline-lg">Simple, Transparent Pricing</h2>
      <p class="font-body-md text-body-md text-slate-300">Start with what you need. Add more when you're ready. Full stack bundles integrate all four services, managed together.</p>
    </div>
    <div class="grid grid-cols-1 items-stretch gap-6 lg:grid-cols-3">
      {plans.map((plan) => {
        const popular = plan.name === popularPlan;
        return (
          <article class={`relative flex flex-col gap-5 rounded-2xl p-8 shadow-xl ${popular ? "border-2 border-amber-400/60 bg-gradient-to-br from-[#122b5e] via-[#0d224d] to-[#0a1a3b]" : "border border-blue-400/20 bg-navy-card"}`}>
            {popular && <span class="absolute -top-3 left-8 rounded-full border border-amber-300 bg-gradient-to-r from-amber-500 to-amber-400 px-3 py-1 font-label-sm text-label-sm font-bold text-slate-950">Most Popular</span>}
            <div>
              <h3 class="font-headline-md text-headline-md font-bold text-white">{plan.name}</h3>
              <p class="mt-1 font-label-md text-label-md text-slate-400">One-time setup: {usd(plan.setup)}</p>
            </div>
            <p class="flex items-baseline gap-1">
              <span class="font-headline-xl text-headline-xl text-white">{usd(plan.monthly)}</span>
              <span class="font-body-md text-body-md text-slate-300">/mo</span>
            </p>
            <ul class="flex flex-col gap-2.5 border-t border-white/10 pt-5">
              {planFeatures[plan.name].map((f) => (
                <li class="flex items-start gap-2 font-body-sm text-body-sm text-slate-200">
                  <Icon name="material-symbols:check-circle-outline" class="mt-px h-[18px] w-[18px] shrink-0 text-amber-400" aria-hidden="true" /> {f}
                </li>
              ))}
            </ul>
            <BookButton label="Get Started" class={`mt-auto px-6 py-3 font-label-lg text-label-lg ${popular ? "btn-gold" : "inline-flex items-center justify-center rounded-xl border border-white/20 bg-white/10 font-bold text-white transition-all hover:bg-white/15"}`} />
          </article>
        );
      })}
    </div>

    <div class="rounded-2xl border border-blue-400/20 bg-navy-card p-6 sm:p-8">
      <h3 class="font-headline-md text-headline-md font-bold text-white">Just Need One Thing? Start There.</h3>
      <p class="mt-1 font-body-sm text-body-sm text-slate-300">Every service is available standalone — no package required.</p>
      <div class="mt-5 overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-white/10 font-label-md text-label-md uppercase text-slate-400">
              <th scope="col" class="py-3 pr-4 font-semibold">Service</th>
              <th scope="col" class="py-3 pr-4 font-semibold">Monthly</th>
              <th scope="col" class="py-3 font-semibold">Setup fee</th>
            </tr>
          </thead>
          <tbody>
            {services.map((s) => (
              <tr class="border-b border-white/5 font-body-sm text-body-sm text-slate-200">
                <th scope="row" class="py-3 pr-4 font-semibold text-white">{s.name}</th>
                <td class="py-3 pr-4">From {usd(s.from_monthly)}/mo</td>
                <td class="py-3">{usd(s.setup)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-5 font-body-sm text-body-sm text-slate-300">Not sure where to start? Book a free strategy call and we'll scope the right solution for your business.</p>
    </div>
  </div>
</section>
